<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!--
      Applies the theme before first paint, so no frame shows the wrong one: the
      stylesheet below is render-blocking, and this runs ahead of it. The choice
      (system, light or dark; dark when none is stored) lives in localStorage and
      becomes `data-theme` (a daisyUI theme from app.css) plus `data-theme-choice`
      (what the top bar toggle shows). The CSP nonce allows exactly this script.
    --%>
    <script nonce={@csp_nonce}>
      (() => {
        const root = document.documentElement;
        const systemDark = matchMedia("(prefers-color-scheme: dark)");
        const choices = ["system", "light", "dark"];

        const apply = (stored) => {
          const choice = choices.includes(stored) ? stored : "dark";
          const mode = choice === "system" ? (systemDark.matches ? "dark" : "light") : choice;
          root.setAttribute("data-theme", `lanternhall-${mode}`);
          root.setAttribute("data-theme-choice", choice);
        };

        // Reading `localStorage` throws when the browser blocks site storage, and writing
        // throws when it is full. The choice then lives only in `data-theme-choice`, for as
        // long as this page is open.
        const load = () => {
          try {
            return localStorage.getItem("phx:theme");
          } catch {
            return null;
          }
        };
        const save = (choice) => {
          try {
            localStorage.setItem("phx:theme", choice);
          } catch {
            // Blocked or full storage: the choice is not kept.
          }
        };

        apply(load());
        window.addEventListener("storage", (e) => e.key === "phx:theme" && apply(e.newValue));
        window.addEventListener("phx:set-theme", (e) => {
          save(e.target.dataset.phxTheme);
          apply(e.target.dataset.phxTheme);
        });
        systemDark.addEventListener("change", () => {
          if (root.getAttribute("data-theme-choice") === "system") apply("system");
        });
      })();
    </script>
    <.live_title default="Lanternhall" suffix=" · Lanternhall" phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- PNG first with `sizes`, so browsers that read SVG favicons pick the SVG. --%>
    <link rel="icon" href={~p"/images/favicon-32.png"} sizes="32x32" type="image/png" />
    <link rel="icon" href={~p"/images/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <%!-- A plain path, not ~p: in prod ~p links the digested manifest-<hash>.webmanifest,
         which Plug.Static never serves (its `only` option names manifest.webmanifest
         exactly). The manifest's "id" keeps the app's identity. --%>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
